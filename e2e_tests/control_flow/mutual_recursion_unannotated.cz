// @backends: all
// Mutual recursion without a return annotation compiles at the return type
// the checker settled for each instantiation in the cycle (`int32`, from the
// literal returns), so the typed back ends run it.
fun flip(n: int64) {
    if n == 0 {
        return 0
    }
    return flop(n - 1)
}

fun flop(n: int64) {
    if n == 0 {
        return 1
    }
    return flip(n - 1)
}

fun main() {
    println(flip(4))
}
