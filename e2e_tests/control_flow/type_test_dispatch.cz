fun length(val) {
    const bytes = if val: infer {
        to_bytes(val)
    } else if val: uint8[] {
        val
    } else if val: infer[] {
        val
    } else {
        return error("unsupported")
    }
    return bytes.len()
}

fun main() {
    println("str {length("hello")}")
    println("ints {length([1, 2, 3])}")
    println("bytes {length(to_bytes("ab"))}")
    println("sum {length("xy") + 1}")
    match length(true) {
        Ok { value } => println("bool ok")
        Err { error } => println("bool err")
    }
}
