// An `if`/`else` statement whose arms both return ends a non-void function:
// the unreachable merge after it needs no value, and each call returns its
// arm's value.
fun classify(x: int32) -> int32 {
    if x == 0 {
        return 100
    } else {
        return 200
    }
}

fun main() {
    println("{classify(0)}")
    println("{classify(7)}")
}
