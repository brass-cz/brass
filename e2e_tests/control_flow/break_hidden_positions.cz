// @lazy: fail
// @eager: fail
//
// A `break` is found wherever it hides: one in a call argument or a `let`
// value makes a `while true` loop breakable, so a `-> int32` function ending
// in that loop may finish without a value and is rejected, and one outside
// any loop is rejected even inside a call argument. Both modes report all
// three errors: a failed lazy run (`f` is the first call) reports the
// checker's complete verdict, including the bodies execution never reaches.
fun f(c: bool) -> int32 {
    while true {
        println(if c { break } else { 1 })
    }
}

fun g(c: bool) -> int32 {
    while true {
        let x = if c { break } else { 0 }
        println(x)
    }
}

fun h(c: bool) {
    println(if c { break } else { 0 })
}

println(f(true))
