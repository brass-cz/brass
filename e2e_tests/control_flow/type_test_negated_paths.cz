// Negation selects per instance, works without else, and prunes incompatible returns.
fun describe(v) {
    if !(v: string) {
        return "not string"
    } else {
        return 17
    }
}
fun no_else(v) {
    if !(v: string) { return 2.5 }
    return 1
}
fun chain(v) -> string {
    if !(v: string) {
        return "other"
    } else if !(v: int32) {
        return "string"
    } else {
        return missing_function(v)
    }
}
fun main() {
    let n: int32? = null
    println(describe(true))
    println(describe(n))
    println(describe("a"))
    println(no_else(true))
    println(no_else("a"))
    println(chain("a"))
    if (n == null): bool { println("bool") }
    if !((n == null): bool) { println("unexpected") }
    if !(n: int32?) { println("unexpected") } else { println("nullable") }
}
