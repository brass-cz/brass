// Pins the for-loop element write-back on every edge that ends an iteration:
// a body reassigning the loop variable updates the array in place when the
// iteration ends via `continue` or `break`, as on the fall-through tail.
fun main() {
    let a = [1, 2, 3]
    for e in a {
        e *= 2
        continue
    }
    println(a)

    let b = [1, 2, 3]
    for e in b {
        e *= 2
        if e > 2 {
            continue
        }
    }
    println(b)

    let c = [1, 2, 3]
    for e in c {
        e = e + 10
        break
    }
    println(c)
}
