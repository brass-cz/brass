// A scalar-element array shared with a spawned task is a SINGLE cown: the
// lock belongs to the array itself, not to its plain `int32` elements, so
// both sides' element updates and pushes -- also those that grow the array --
// are guarded and no update is lost.
fun main() {
    let box = [0]
    let log = ["seed"]
    spawn(() -> {
        let i = 0
        while i < 10000 {
            box[0] += 1
            log.push("x")
            i += 1
        }
    })
    let j = 0
    while j < 10000 {
        box[0] += 1
        log.push("y")
        j += 1
    }
    sync()
    println(box[0])
    println(log.len() - 1)
}
