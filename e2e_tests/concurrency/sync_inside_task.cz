// Pins: `sync()` inside a spawned task skips the task's OWN handle in the
// thread registry, since joining it would be a self-join. The spawner's long
// loop delays its own `sync` so the task's handle is still registered when
// the task calls `sync`; the task's `sync` returns, and main's `sync` still
// reaps the task, so the output order is deterministic.
type Box = {
    value: int64
}

fun main() {
    spawn(() -> {
        sync()
        println("task done")
    })
    let b = Box { value: 0 }
    let j = 0
    while j < 20000000 {
        b.value = b.value + 1
        j = j + 1
    }
    sync()
    println("main done {b.value}")
}
