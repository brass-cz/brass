// Explicit acquisition of a shared object needs no caller-access warning.
type Counter = { count: int32 }
fun main() {
    let counter = Counter { count: 0 }
    spawn(() -> { with(counter, (c) -> { c.count += 1 }) })
    spawn(() -> { with(counter, (c) -> { c.count += 2 }) })
    sync()
    with(counter, (c) -> println(c.count))
}
