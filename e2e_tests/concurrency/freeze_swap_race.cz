// Pins: the task reads `h.inner` while the spawner REPLACES the inner record
// each iteration, releasing the old one. A capture the spawner writes after
// the spawn is a cown, not a frozen share, so the swap is serialized against
// the read and the reader always sees a complete record.
type Inner = {
    value: int64
}
type Holder = {
    inner: Inner
}

fun main() {
    let h = Holder { inner: Inner { value: 0 } }
    spawn(() -> {
        let i = 0
        let sum: int64 = 0
        while i < 200000 {
            sum = sum + h.inner.value
            i = i + 1
        }
        println("reader done")
    })
    let j = 0
    while j < 200000 {
        h.inner = Inner { value: j }
        j = j + 1
    }
    sync()
    println("value = {h.inner.value}")
}
