// Pins: the read-only capture of a spawn through a closure VARIABLE
// (`spawn(task)`) gets an atomic reference count before the spawn, like a
// literal spawn's. Both threads churn references to the shared record through
// a helper (bind/drop aliases in a loop) and both finish with the value intact.
type Node = {
    value: int64
}

fun touch(n) {
    let a = n
    let b = a
    return b.value
}

fun main() {
    let n = Node { value: 42 }
    let task = () -> {
        let i = 0
        let s: int64 = 0
        while i < 200000 {
            s = s + touch(n)
            i = i + 1
        }
        println("task sum ok = {s > 0}")
    }
    spawn(task)
    let j = 0
    let s: int64 = 0
    while j < 200000 {
        s = s + touch(n)
        j = j + 1
    }
    sync()
    println("main sum ok = {s > 0} value = {n.value}")
}
