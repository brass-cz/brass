// Array elements are storage sites: records keep their declared layout and a
// stored value is never converted, so a `Q`, which has `P`'s `x` and more,
// cannot be pushed into a `P[]`.
type P = { x: int32 }
type Q = { y: string, x: int32 }

fun main() {
    let a = [P { x: 1 }]
    a.push(Q { y: "s", x: 2 })
    println(a[1].x)
}
