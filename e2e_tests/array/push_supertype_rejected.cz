// An array element is a storage site: a `Dog[]` takes only a `Dog`, so
// pushing an `Animal`, which lacks `breed`, is rejected.
type Animal = {
    name: string
}

type Dog = {
    name: string
    breed: string
}

fun main() {
    let d = Dog { name: "Rex", breed: "lab" }
    let xs: Dog[] = [d]
    xs.push(Animal { name: "generic" })
}
