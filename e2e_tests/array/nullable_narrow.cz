// A nullable array narrowed by an `if a` guard supports every array
// operation on its inner `int32[]`: `len`, iteration, indexing, an element
// store, `push` and `pop` all act on the present array, and a `null`
// argument takes no branch.
fun describe(a: int32[]?) {
    if a {
        println(a.len())
        for e in a {
            println(e)
        }
        println(a[0])
        a[0] = 100
        println(a[0])
        a.push(7)
        println(a.len())
        let last = a.pop()
        println(last)
    }
}

describe([1, 2, 3])
// The null arm takes neither branch: no output, no crash.
describe(null)
