// `read_file` of a nonexistent path returns a `Result.Err` that the program
// can match and carry on from.
import std.fs.{ read_file }

fun main() {
    match read_file("/nonexistent/brass_missing.txt") {
        Ok { value } => println("read: {value}"),
        Err { error } => println("error: {error}"),
    }
    println("still running")
}
