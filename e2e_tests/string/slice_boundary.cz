// `_string_slice` on UTF-8 text: a byte range that lands mid-character snaps
// back to the nearest character boundary, on the JIT as in the interpreter,
// so a slice is always valid UTF-8. "héllo" is h(1 byte) é(2 bytes) llo:
//  - [0,2) ends mid-é, snaps to [0,1) = "h";
//  - [2,3) starts mid-é, snaps to [1,3) = "é";
//  - [1,2) both mid-é endpoints collapse to [1,1) = "".
// A multibyte slice is an ordinary string that `_string_find` searches, and
// a start beyond the end yields an empty slice.
fun main() {
    let s = "héllo"
    let a = _string_slice(s, 0, 2)
    println(a)
    println(a.len())
    let b = _string_slice(s, 2, 3)
    println(b)
    println(b.len())
    let c = _string_slice(s, 1, 2)
    println(c.len())
    // A start beyond the end clamps to the end and yields an empty slice.
    println(_string_slice(s, 99, 100).len())
    let f = _string_find(b, "z")
    if f {
        println("found")
    } else {
        println("not found")
    }
}
