// `trim` on strings whose edges are multibyte UTF-8 characters: the trailing
// probe `_string_char_at(s, end - 1)` lands mid-character there and yields
// null, which counts as "not whitespace", so the character is preserved.
// ASCII whitespace around multibyte text still strips on both sides.
fun main() {
    println(" héllo ".trim())
    println("héé".trim())
    println("あいう".trim())
    println("  あ  ".trim())
    println("\t é \n".trim())
    println("".trim())
    println("   ".trim().len())
}
