// Interpolating the nullable string `_string_char_at` returns: a present
// character renders as itself (its text is the cell's own string, shared with
// the segment rather than copied) and an absent one as `null`.
fun main() {
    let c = _string_char_at("ab", 1)
    println("got={c}")
    let miss = _string_char_at("ab", 9)
    println("miss={miss}")
}
