// Pins comparison-operand typing when an int literal is wider than the
// variable's kind: `b < 300` compares at the common (wider) type -- truncated
// into uint8, 300 would be 44 and `200 < 300` false. A literal that fits
// still adapts to the variable's kind (`b < 250` compares as uint8).
fun main() {
    let b: uint8 = 200
    if b < 300 {
        println("less")
    } else {
        println("not less")
    }
    if b < 250 {
        println("fits-less")
    } else {
        println("fits-not-less")
    }
    if b > 100 {
        println("greater")
    }
}
