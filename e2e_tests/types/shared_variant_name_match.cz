// Pins deterministic owning-sum resolution when two sums share variant names:
// the bare variant patterns of each match resolve to the matched value's sum,
// so the exhaustive match on `Big` (with `Z`) and the one on `Small` are both
// accepted on every run.
type Small =
    | X { a: int32 }
    | Y { a: int32 }

type Big =
    | X { a: int32 }
    | Y { a: int32 }
    | Z { a: int32 }

fun f(v: Big) -> int32 {
    return match v {
        X { a } => a,
        Y { a } => a,
        Z { a } => a,
    }
}

fun g(v: Small) -> int32 {
    return match v {
        X { a } => a,
        Y { a } => a,
    }
}

println(f(Big.Z { a: 7 }))
println(g(Small.X { a: 3 }))
