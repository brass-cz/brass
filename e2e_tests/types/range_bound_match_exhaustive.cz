// Pins that the exhaustiveness check sees inside RANGE literal bounds: a
// non-exhaustive sum match hidden in `[0..(match ...)]` is rejected like one
// anywhere else.
type S =
    | A { v: int32 }
    | B { v: int32 }

fun f(s: S) {
    println([0..(match s { A { v } => v })])
}

f(S.B { v: 3 })
