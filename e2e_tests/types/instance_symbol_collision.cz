// Pins that monomorphized instances of distinct argument types stay distinct
// even when the type names contain `_`: (A_B, C) and (A, B_C) must not share
// one instance although joining the names with `_` would key both as
// `get__A_B_C`, so the second call reads its string field as a string.
type A_B =
    | P { v: int32 }

type C =
    | Q { v: int32 }

type A =
    | R { v: int32 }

type B_C =
    | S { v: string }

fun get(x, y) {
    return y.v
}

fun main() {
    println(get(A_B.P { v: 1 }, C.Q { v: 7 }))
    println(get(A.R { v: 1 }, B_C.S { v: "hello" }))
}
