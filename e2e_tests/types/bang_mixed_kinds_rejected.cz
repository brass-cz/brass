// One `!` span in a generic body, a nullable operand in one instantiation and
// a `Result` in another. The two propagate differently and the instantiations
// share a single MIR lowering, so no one shape is right: the checker rejects
// the program (the null-propagation shape would render the whole
// `Result.Ok {..}` of the Result instance where its payload is meant).
fun might_fail(ok: bool) -> int32! {
    if ok { return 41 }
    return error("boom")
}

fun show(x) {
    return "value: {x!}"
}

fun main() {
    let n: int32? = 5
    println(show(n))
    let r = might_fail(true)
    println(show(r))
}
