// @backends: all
// Repeated nullable suffixes collapse in bindings, signatures, and nested types.
type N = int32?
type P = { v: int32 }
let global: int32?? = 3
fun show(x: int32??) {
    println(typeof(x))
    println(x)
}
fun main() {
    println(typeof(global))
    println(global)
    let local: int32??? = 3
    println(typeof(local))
    println(local)
    show(3)
    let closure = (x: int32??) -> x
    println(typeof(closure))
    println(closure(3))
    let alias: N? = 3
    println(typeof(alias))
    println(alias)
    let f: (int32??) -> int32?? = (x) -> x
    println(typeof(f))
    println(f(3))
    let optional: int32?? = null
    println(typeof(optional))
    println(optional)
    optional = 3
    println(optional)
    let array: int32??[] = [3, null]
    println(typeof(array))
    println(array)
    let tuple: [int32??, string] = [3, "a"]
    println(typeof(tuple))
    println(tuple)
    let p: P? = P { v: 3 }
    let nominal: P?? = p
    println(typeof(nominal))
    println(nominal)
    let reflected: typeof(local)?? = 3
    println(typeof(reflected))
    println(reflected)
}
