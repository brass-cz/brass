// @backends: all
// INT64_MIN is provided by the prelude and also writable as one literal: a
// negated literal is typed by its value, sign included, so
// -9223372036854775808 fits int64.
fun main() {
    println(INT64_MIN)
    println(INT64_MIN + 1 == -INT64_MAX)
    println(INT64_MIN == -9223372036854775808)
    println(typeof(-9223372036854775808))
}
