// Pins that distinct instances get distinct compiled functions even when
// their type names differ only in punctuation: `int32?[]` (array of
// nullables) and `int32[]?` (nullable array) instantiate `probe` twice, and
// each call runs its own instance.
fun probe(x) -> int64 {
    if x {
        return x.len()
    }
    return -1
}

fun main() {
    let a: int32?[] = [1, 2, 3]
    let b: int32[]? = [4, 5]
    println(probe(a))
    println(probe(b))
}
