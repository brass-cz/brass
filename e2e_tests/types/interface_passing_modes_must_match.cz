// Interface implementations require the same parameter passing mode as each
// required member; every distinct pair is rejected in both directions.
type Big = { a: int32 }

type PlainAgainstRefRequirement = { w(self, x: ref(Big)) -> int32 }
type PlainAgainstRefImplementation: PlainAgainstRefRequirement = { n: int32 }
fun PlainAgainstRefImplementation.w(self, x: Big) -> int32 { return 1 }

type PlainAgainstMutRequirement = { w(self, x: mut(Big)) -> int32 }
type PlainAgainstMutImplementation: PlainAgainstMutRequirement = { n: int32 }
fun PlainAgainstMutImplementation.w(self, x: Big) -> int32 { return 1 }

type PlainAgainstRefMutRequirement = { w(self, x: ref(mut(Big))) -> int32 }
type PlainAgainstRefMutImplementation: PlainAgainstRefMutRequirement = { n: int32 }
fun PlainAgainstRefMutImplementation.w(self, x: Big) -> int32 { return 1 }

type RefAgainstPlainRequirement = { w(self, x: Big) -> int32 }
type RefAgainstPlainImplementation: RefAgainstPlainRequirement = { n: int32 }
fun RefAgainstPlainImplementation.w(self, x: ref(Big)) -> int32 { return 1 }

type RefAgainstMutRequirement = { w(self, x: mut(Big)) -> int32 }
type RefAgainstMutImplementation: RefAgainstMutRequirement = { n: int32 }
fun RefAgainstMutImplementation.w(self, x: ref(Big)) -> int32 { return 1 }

