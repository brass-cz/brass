// @backends: all
// A float literal operand adapts to a float32 operand when it stays finite
// there, like an integer literal does, so float32 arithmetic with literals
// stays float32 (`c * 2.0` can be stored back into a float32). A literal too
// large for float32 keeps float64, and a float literal next to an integer
// meets it at float64. A literal branch of an `if` adapts the same way.
fun halve(c: float32) {
    return c * 0.5
}

fun main() {
    let c: float32 = 1.5
    let d: float32 = c * 2.0
    println("{d} {typeof(c * 2.0)}")
    println(typeof(c * 1e39))
    println("{c - -0.25} {typeof(c - -0.25)}")
    println("{halve(3.0)} {typeof(halve(3.0))}")
    let n: int32 = 3
    println("{n * 0.5} {typeof(n * 0.5)}")
    let q = if c > 1.0 { c } else { 0.5 }
    println(typeof(q))
    let r: float32 = -0.5
    println(r)
}
