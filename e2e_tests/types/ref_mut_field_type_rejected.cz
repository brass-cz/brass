// A `ref(mut(T))` parameter exposes the underlying record's fields: storing a
// value of the wrong type through the reference is a type error, exactly as
// a direct store of it into the field would be.
type Point = { x: int32 }

fun poke(p: ref(mut(Point))) {
    p.x = "not an int"
}

fun main() {
    let pt = Point { x: 1 }
    poke(pt)
    println(pt.x + 1)
}
