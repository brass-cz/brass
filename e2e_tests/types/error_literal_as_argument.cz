// A bare `error("..")` passed straight into a `T!` position takes that
// position's Ok payload: `unwrap_or(error("boom"), -1)` builds an `int32!`
// and `describe(error("nope"))` a `string!`.
//
// `error(..)` produces no Ok value, so nothing in the expression constrains
// its Ok payload -- only the position it flows into decides it. The argument
// is therefore typed by the parameter, never by the enclosing callable's own
// return type: `main` is fallible here with a `void` Ok payload, and typing
// the argument from it would instantiate `unwrap_or` at
// `Result<void, string>` and return a `void` payload from a function
// declared `int32`.
//
// A value bound first (`const r: int32! = error("bound")`) and a real Ok
// value reach the same instance. The Err that `describe` renders keeps the
// location of the `error(..)` call that built it, inside the argument list
// of `main`.

fun unwrap_or(r: int32!, dflt: int32) -> int32 {
    match r {
        Ok { value } => { return value }
        Err { error } => { return dflt }
    }
}

fun describe(r: string!) -> string {
    match r {
        Ok { value } => { return value }
        Err { error } => { return "err: {error}" }
    }
}

fun main() {
    // Directly as an argument, from a fallible `main` (whose own return type used
    // to be what typed these).
    println(unwrap_or(error("boom"), -1))
    println(describe(error("nope")))

    // The same value bound first still works (this path always did).
    const r: int32! = error("bound")
    println(unwrap_or(r, -2))

    // And a real Ok value takes the same instance.
    println(unwrap_or(ok_int(7), -3))
}

fun ok_int(n: int32) -> int32! {
    return n
}
