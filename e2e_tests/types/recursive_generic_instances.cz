// @backends: all
// A generic recursive function's recursive call is typed at the instance being
// elaborated: calling it at `int32` first must not fix the type its recursive
// call returns for the later `string` instance (plain and fallible bodies).
fun f(x, n) {
    if n == 0 {
        return x
    }
    return f(x, n - 1)
}

fun g(x, n) {
    if n < 0 {
        error("neg")!
    }
    if n == 0 {
        return x
    }
    return g(x, n - 1)!
}

fun main() {
    println(f(1, 3))
    println(f("s", 3))
    println(g(1, 3)!)
    println(g("s", 3)!)
}
