import std.collections.{ HashMap }

// A `type Alias = Base { .. }` refinement naming a concrete instance resolves
// in a callable's SIGNATURE exactly as in a `let` annotation or a sum
// variant's field, although the alias is not a nominal type:
//
//   * a parameter annotated `_Tbl` is the pinned map in a method and in a
//     free function alike, so the body uses it as that map and a free
//     function's `_Tbl` parameter accepts only that map;
//   * a declared `-> _Tbl!` is a `Result`, so the caller's `!` and `match`
//     unwrap it, also for a method with no error path of its own.
//
// The free function `_child` and the methods `Cursor.grow` and
// `Cursor.fresh` cover parameters and fallible returns of both kinds of
// callable; the duplicate key that `_child` reports reaches the caller of
// `Cursor.grow` as an Err.

type _Tbl = HashMap { key: string, value: int64 }

type Cursor = {
    at: int64
}

// Free function: parameter and fallible return both name the alias.
fun _child(parent: _Tbl, key: string, weight: int64) -> _Tbl! {
    if parent.contains_key(key) {
        return error("duplicate key '{key}'")
    }
    parent.set(key, weight)
    return parent
}

// Method: alias parameter (used to be `void`) and alias fallible return.
fun Cursor.grow(self, parent: _Tbl, key: string) -> _Tbl! {
    self.at += 1
    let w: int64 = 2
    return _child(parent, key, w)!
}

// Method: alias return with NO error path -- the declared `!` must still wrap.
fun Cursor.fresh(self) -> _Tbl! {
    let seed: int64 = 100
    let t: _Tbl = HashMap.new()
    t.set("seed", seed)
    return t
}

// Free function: the alias parameter is a real constraint now.
fun total(t: _Tbl) -> int64 {
    let sum: int64 = 0
    for v in t.values() {
        sum += v
    }
    return sum
}

fun main() {
    let c = Cursor { at: 0 }
    let m = c.fresh()!
    println(total(m))

    let grown = c.grow(m, "a")!
    println(total(grown))
    println(c.at)

    // The alias-annotated fallible return really is a `Result`.
    match c.grow(grown, "a") {
        Ok { value } => println("unexpected"),
        Err { error } => println("err: {error}"),
    }
}
