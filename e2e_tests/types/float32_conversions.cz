// float32 conversions (`float32.from`, `float32.parse`) produce values at
// 32-bit precision on the JIT, so arithmetic on them and their rendering
// match the interpreter byte-for-byte.
fun main() {
    let a = float32.from(1)
    let b = float32.from(3)
    println(a / b)
    println(float32.from(10))
    println(float32.parse("2.5")!)
}
