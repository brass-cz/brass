// Two capture rules for closures: a name used only inside a range expression
// (`[0..n]`) is still captured, and a read before a same-named later `let`
// in the closure body refers to the outer binding and captures it (the inner
// `let` shadows only from its declaration on).
fun main() {
    let n = 5
    let f = () -> {
        let r = [0..n]
        return r.len()
    }
    println(f())

    let y = 10
    let g = () -> {
        println(y)
        let y = 5
        println(y)
    }
    g()
}
