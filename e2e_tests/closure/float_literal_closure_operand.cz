// @backends: all
// A float literal next to an unannotated closure parameter adapts only to a
// float argument: applied to an integer the operation is computed in
// `float64` (an integer and a float literal meet at the common type), applied
// to a `float32` it stays `float32`. The closure's result follows each
// application, also for a module-level binding and through `map`.
const scale = (x) -> x * 2.5

fun apply(f, v) {
    return f(v)
}

fun main() {
    println(scale(1))
    let i: int32 = 3
    println(scale(i))
    println(typeof(scale(i)))
    let f: float32 = 1.5
    println(typeof(scale(f)))
    println([1, 2].map((x) -> x * 2.5))
    let s: int16 = 3
    println([s].map((x) -> x / 2.0))
    println(apply((x) -> x * 2.5, 1))
}
