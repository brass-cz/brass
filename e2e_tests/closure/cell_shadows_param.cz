// A `let` that shadows a parameter name is a local of its own: a closure that
// captures and mutates it shares it with the function through a cell, even
// though a parameter has the same name, so `f` sees the closure's increment
// and returns 11.
fun f(x: int32) -> int32 {
    let x = 10
    let inc = () -> {
        x = x + 1
    }
    inc()
    return x
}

fun main() {
    println(f(1))
}
