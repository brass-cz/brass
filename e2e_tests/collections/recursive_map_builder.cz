import std.collections.{ HashMap }

// A recursive, UNANNOTATED, fallible function that builds a witness-free
// container and merges its own recursive result back into it: the recursive
// call returns the same `HashMap` instance the body builds (`string` keys,
// `int64` values), so `collect(..)!.pairs()` reads it at those types.

fun collect(names: string[]) {
    let result = HashMap.new()
    for n in names {
        result.set(n, n.len())
        // Merge what the recursion found. `names` shrinks, so this terminates.
        if len(names) > 1 {
            for [k, v] in collect([names[0]])!.pairs() {
                result.set(k, v)
            }
        }
    }
    if len(names) > 100 {
        return error("too many names")
    }
    return result
}

// A bare nominal annotation leaves the map's key/value to the call site.
fun render(m: HashMap) {
    // Slot order is unspecified, so the keys are looked up in a fixed order.
    let out: string[] = []
    for k in ["a", "bb", "ccc"] {
        if let v = m.get(k) {
            out.push("{k}={v}")
        }
    }
    return out.join(",")
}

fun main() {
    println(render(collect(["a", "bb", "ccc"])!))
}
