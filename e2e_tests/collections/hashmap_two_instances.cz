// Two HashMap instantiations with different value types in one program. Both
// render as the bare name `HashMap` (their members are all `_`-private), yet
// each instance keeps its own per-type code -- destructor, rendering, deep
// copy -- so each map prints, reads and releases its own values. The
// string-valued map comes first, so its per-type code is generated first.
fun main() {
    let a = HashMap.new()
    a.set("s", "seven")
    let b = HashMap.new()
    b.set("n", 7)

    println(a.pairs())
    println(b.pairs())
    println(a.get_or("s", ""))
    println(b.get_or("n", 0))
    // Both maps drop at function exit: each must run its own destructor.
}
