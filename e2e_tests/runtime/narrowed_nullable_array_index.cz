// A nullable index (`string.find` returns `int64?`) narrowed by a guard
// indexes an array like the plain `int64` it is, both directly and through an
// unannotated copy of the narrowed binding.

fun main() {
    let cs = "abc".chars()

    let i = "abc".find("b")
    if !i { return }
    assert(cs[i] == "b", "index by a narrowed nullable")

    // Same value copied into a fresh binding, still without an annotation.
    let j = i
    assert(cs[j] == "b", "index by a copy of a narrowed nullable")

    println("ok")
}
