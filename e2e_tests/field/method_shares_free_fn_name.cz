// A method call is completed from the method's own signature, not from a
// same-named free function's: `describe` exists both as a free function with
// a trailing nullable parameter and as a `Box` method, so `b.describe()`
// calls the method with no extra argument, while `describe(1)` still omits
// the free function's `extra`.
type Box = { v: int32 }

fun describe(a: int32, extra: string?) -> string {
    return "free"
}

fun Box.describe(self) -> string {
    return "method {self.v}"
}

fun main() {
    let b = Box { v: 7 }
    println(b.describe())
    println(describe(1))
}
