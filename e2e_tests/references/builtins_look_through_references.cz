// @backends: all
// A `ref`/`ref(mut(..))` parameter is used like the value it refers to by
// the builtins too: `len` (and `.len()`) of a referenced array or string, the
// internal string primitives, and the `parse`/`from` conversions accept it.
fun count(log: ref(mut(int32[]))) -> int64 {
    log.push(1)
    return len(log) + log.len()
}

fun size(s: ref(string)) -> int64 {
    let found = _string_find(_string_concat(s, s), "c")
    if found {
        return len(s) + found
    }
    return len(s)
}

fun parsed(s: ref(string)) -> int32! {
    return int32.parse(s)!
}

fun widened(n: ref(int32)) -> int64! {
    return int64.from(n)!
}

fun main() {
    let xs: int32[] = [5]
    println(count(xs))
    println(len(xs))
    println(size("abc"))
    match parsed("42") {
        Ok { value } => println(value),
        Err { error } => println("bad"),
    }
    match widened(7) {
        Ok { value } => println(value),
        Err { error } => println("bad"),
    }
}
