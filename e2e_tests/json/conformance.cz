import std.data.json.{ JsonValue }

fun show_number(text: string) {
    match JsonValue.parse(text) {
        Ok { value } => println("{text}: accepted"),
        Err { error } => println("{text}: rejected"),
    }
}

const escaped = JsonValue.parse("\"\\b\\f\\u0041\\uD834\\uDD1E\"")!
println(escaped.as_string()!.len())
println(escaped.stringify())
println(JsonValue.parse("\"\\u0001\"")!.stringify())

show_number("+1")
show_number("01")
show_number("1.")
show_number(".1")
show_number("1e999")
show_number("-0.25e+2")

let raw = to_bytes("\"\"")
raw.remove(1)
raw.push(uint8.from(1)!)
raw.push(uint8.from(34)!)
match JsonValue.parse(to_text(raw)!) {
    Ok { value } => println("raw control accepted"),
    Err { error } => println("raw control rejected"),
}
match JsonValue.parse("\"\\uD800\"") {
    Ok { value } => println("lone surrogate accepted"),
    Err { error } => println("lone surrogate rejected"),
}
