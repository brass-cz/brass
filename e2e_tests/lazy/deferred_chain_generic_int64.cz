// @backends: all
//
// A chain of generic functions deeper than the checker's elaboration depth,
// called at int64 and at int32. The calls past that depth are typed from a
// fallback return, which is only an approximation for a generic callee (here
// an `int32`), so no elaboration that used one may report its return as the
// instance's: the lazy run compiles every deferred call site at the
// instance's real return (`int64` for the first call) and runs the chain like
// the whole-program pipelines.
fun d0(x) { return d1(x) + 1 }
fun d1(x) { return d2(x) + 1 }
fun d2(x) { return d3(x) + 1 }
fun d3(x) { return d4(x) + 1 }
fun d4(x) { return d5(x) + 1 }
fun d5(x) { return d6(x) + 1 }
fun d6(x) { return d7(x) + 1 }
fun d7(x) { return d8(x) + 1 }
fun d8(x) { return d9(x) + 1 }
fun d9(x) { return d10(x) + 1 }
fun d10(x) { return d11(x) + 1 }
fun d11(x) { return d12(x) + 1 }
fun d12(x) { return d13(x) + 1 }
fun d13(x) { return d14(x) + 1 }
