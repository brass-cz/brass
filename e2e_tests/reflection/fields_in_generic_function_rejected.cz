// A generic function's `fields(v)` loop is still checked at every
// instantiation: a non-record argument is rejected at the operand, and two
// record types with different field lists cannot share the one unrolled body.
type P = { x: int32, name: string }
type Q = { y: bool }

fun dump(v) {
    for f in fields(v) {
        println("{f} = {v[f]}")
    }
}

fun main() {
    dump(P { x: 1, name: "n" })
    dump(Q { y: true })
    dump(5)
}
