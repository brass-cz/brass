// A `let y: typeof(x) = x` slot in a generic body takes each instance's own
// type: the string, the record and the integer instance of `dup` each bind
// and return their own value, although all instances share one MIR body.
type A = { v: int64 }

fun dup(x) {
    let y: typeof(x) = x
    return y
}

println(dup("s"))
println(dup(A { v: 7 }).v)
println(dup(42))
