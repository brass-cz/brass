// A parameter used as a method RECEIVER is view-ineligible: dispatch needs the
// full value, so the callee is compiled at the argument's own type and the
// structural method resolution sees every field of the caller's value.
type Person = {
    name: string
}

fun Person.hello(self) {
    println("I am {self.name}")
}

fun call_hello(p) {
    p.hello()
}

fun main() {
    call_hello({ name: "Asimov", age: 72 })
}
