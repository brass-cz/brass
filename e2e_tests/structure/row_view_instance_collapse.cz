// Differently-shaped anonymous arguments share a compiled instance of
// `display` whenever their views agree: the view keeps only the fields the
// body uses (`first_name` tested for presence, `last_name` read) at the
// argument's own types, so extra fields never key new instances, and an
// absent tested field reads as null through its own view.
fun display(obj) -> string {
    if obj.first_name {
        return obj.first_name
    }
    return obj.last_name
}

fun main() {
    println(display({ first_name: "Ada", last_name: "Lovelace" }))
    println(display({ first_name: "Alan", last_name: "Turing", age: 41 }))
    println(display({ last_name: "Euler", country: "CH" }))
}
