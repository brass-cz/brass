// Top-level code is checked like a function body: an `Animal` cannot be stored
// as a `Dog` (an annotated binding, a field initializer, a closure's local),
// nor passed as one, since it lacks `Dog`'s `age`.
type Animal = { name: string }
type Dog = { name: string, age: int64 }
type Kennel = { pet: Dog }

fun years(d: Dog) -> int64 {
    return d.age * 7
}

let a = Animal { name: "cat" }
let d: Dog = a
let k = Kennel { pet: Animal { name: "cat" } }
println(years(Animal { name: "cat" }))
const c = () -> {
    let inner: Dog = Animal { name: "c" }
    return inner.age + 5
}
println(c())
