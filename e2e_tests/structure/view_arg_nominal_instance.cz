// A generic forwarder (`mid`) hands its parameter to a function that reads one
// field. Called with anonymous records of different shapes and with a nominal
// `N`, every call reads its own `a`, and the program exits cleanly after the
// last line.
type N = { a: int64, c: string }

fun takes(p) -> int64 {
    return p.a
}

fun mid(x) {
    return takes(x)
}

fun main() {
    println(mid({ a: 1, b: 2 }))
    println(mid(N { a: 3, c: "z" }))
    println(mid({ a: 4, d: 9.5 }))
}
