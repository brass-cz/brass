// Matching a narrowed nullable SUM dispatches on the actual variant: the
// scrutinee local is declared `S?`, and the match tests the present value's
// tag, so the `B` value takes the `B` arm and the `A` value binds its `x`.
type S = | A { x: int32 } | B

fun m(c: int32) -> S? {
    if c == 0 {
        return S.A { x: 5 }
    }
    if c == 1 {
        return S.B
    }
    return null
}

fun show(c: int32) {
    let r = m(c)
    if r {
        match r {
            A { x } => println("a {x}"),
            B => println("b"),
        }
    } else {
        println("none")
    }
}

show(0)
show(1)
show(2)
