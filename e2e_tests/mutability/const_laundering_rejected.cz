// A const cannot reach a write-through `ref(mut)` parameter through call
// indirection: not through a local alias of the function (`let f = mutate;
// f(o)`), and not through a higher-order function that calls the function
// value it receives on its REFERENCE parameter (`apply_ref(mutate, o)`, whose
// `v: ref(P)` is passed to `f`). An unannotated parameter that is mutated --
// by a self-mutating method, or by forwarding it into a `ref(mut)` position,
// a function value's included -- is a private deep copy instead, so a const
// is accepted there (see method_mutation_copies_param.cz and
// closure/forwarded_param_into_ref_mut_closure_copies.cz).
type P = { x: int32 }

fun mutate(p: ref(mut(P))) {
    p.x = 42
}

fun apply_ref(f, v: ref(P)) {
    f(v)
}

fun main() {
    const o = P { x: 1 }
    let f = mutate
    f(o)

    apply_ref(mutate, o)
}
