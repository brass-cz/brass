// Network-dependent package fetching, kept OUT of czpm's resolve module on
// purpose: this file is its own `brass` entry that resolve.cz runs as a
// child process for the rare dependency kinds that need it. Importing
// `std.http` here instead of in resolve.cz keeps the whole net/http/url
// stack (and its checking cost) off every czpm start; a tarball dependency
// already spawns `tar` and hits the network, so one short-lived extra
// `brass` process is noise on that path.
//
// Protocol: `brass fetch.cz tarball <url> <sha256-hex>` prints the extracted
// package directory on stdout and exits 0; any failure reports on stderr
// through the normal unhandled-error path and exits non-zero.

import std.env
import std.fs.{ create_dir, move_dir, remove_dir }
import std.hash.{ sha256, hex }
import std.http.fetch
import std.path.Path
import std.process.{ Command, Stdio }

// Duplicated from resolve.cz deliberately: importing it from there would pull
// the manifest/TOML closure into this entry, and importing it from here would
// pull HTTP into czpm -- the exact coupling this file exists to break.
fun _packages_dir() {
    return Path.home()!.join(".brass").join("packages")
}

fun download_and_extract_tarball(url: string, hash: string) {
    if !_valid_sha256(hash) {
        return error("tarball hash must be exactly 64 lowercase hexadecimal characters")
    }
    const cache = _packages_dir()!.join("tarball")
    if !cache.is_dir() {
        create_dir(cache)!
    }
    const path = cache.join(hash)
    if _complete(path) {
        return path
    }
    if path.is_dir() {
        remove_dir(path)!
    }
    const downloaded = fetch(url)!
    const downloaded_hash = hex(sha256(downloaded.body))
    if downloaded_hash != hash {
        error(
            "Downloaded tarball hash `{downloaded_hash}` is differ from expected one `{hash}`",
        )!
    }
    const staging = _staging_dir(cache, hash)!
    const populated = _populate(staging, downloaded.body)
    match populated {
        Err { error } => {
            remove_dir(staging)!
        }
        Ok { value } => {}
    }
    populated!
    match move_dir(staging, path) {
        Ok { value } => { return path }
        Err { error } => {
            remove_dir(staging)!
            // Another process may have published the same verified package.
            if _complete(path) {
                return path
            }
            return error("failed to publish the extracted tarball")
        }
    }
}

fun _populate(path: Path, body: uint8[]) {
    let cmd = Command.new("tar")
    cmd.args(["xz", "-C", path.to_string()])
    cmd.stdin(Stdio.Pipe)
    const child = cmd.spawn()!
    let tar_in = child.stdin()!
    tar_in.write(body)!
    tar_in.close()!
    const code = child.wait()!
    if code != 0 {
        return error("failed to extract downloaded tarball")
    }
    // A directory marker cannot be followed as a file symlink. Its presence in
    // the final directory proves extraction reached the publication step.
    create_dir(path.join(".czpm-complete"))!
}

fun _complete(path: Path) -> bool {
    return path.is_dir() && path.join(".czpm-complete").is_dir()
}

fun _valid_sha256(hash: string) -> bool {
    if len(hash) != 64 {
        return false
    }
    for b in to_bytes(hash) {
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) {
            return false
        }
    }
    return true
}

// Use a short-lived shell's process id to reserve a sibling directory. mkdir
// is the exclusive operation; a concurrent fetch therefore gets its own tree.
fun _staging_dir(parent: Path, key: string) -> Path! {
    let cmd = Command.new("sh")
    cmd.args([
        "-c",
        "umask 077; stage=\"$1/.$2.$$\"; mkdir \"$stage\" && printf '%s' \"$stage\"",
        "czpm-stage",
        parent.to_string(),
        key,
    ])
    cmd.stdout(Stdio.Pipe)
    const child = cmd.spawn()!
    const out = child.output()!
    if out.code != 0 {
        return error("failed to create a tarball staging directory")
    }
    return Path.parse(to_text(out.stdout)!)
}

// The entry `main` runs automatically; an explicit top-level call would run
// it a second time and print the path twice.
fun main() {
    const args = env.args()
    if args.len() != 4 || args[1] != "tarball" {
        return error("usage: fetch.cz tarball <url> <sha256-hex>")
    }
    const path = download_and_extract_tarball(args[2], args[3])!
    println(path.to_string())
}
