import std.net.{ Tcp, TlsStream }
import std.url.{ URI }

type Header = {
    name: string
    value: string
}

type HttpRequest = {
    method: string
    path: string
    version: string
    headers: Header[]
    body: uint8[]
}

type HttpResponse = {
    version: string
    status: int32
    reason: string
    headers: Header[]
    body: uint8[]
}

type _HttpHead = {
    line: string
    headers: Header[]
}

type _HttpMessage = {
    head: _HttpHead
    body: uint8[]
}

type _StatusLine = {
    version: string
    status: int32
    reason: string
}

type _HostPort = {
    host: string
    port: int32
}

// One `_scan_chunks` pass: the payload of the chunks it decoded, the bytes
// of input those chunks fully consumed, and whether the coding's terminator
// was reached.
type _ChunkScan = {
    body: uint8[]
    consumed: int64
    done: bool
}

// --- internal helpers ---

fun _split_once(s: string, delim: string) {
    let parts = s.split(delim)
    if len(parts) < 2 { error("delimiter not found")! }
    return [parts[0], parts.slice(1, len(parts)).join(delim)]
}

// \r\n\r\n (13,10,13,10) in byte array
fun _find_header_end(data: uint8[]) -> int64? {
    if len(data) < 4 { return null }
    for i in [0..len(data) - 3] {
        if data[i] == 13 && data[i + 1] == 10 &&
           data[i + 2] == 13 && data[i + 3] == 10 {
            return i
        }
    }
    return null
}

fun _find_header(headers: Header[], name: string) -> string? {
    let lower = name.to_lower()
    for h in headers {
        if h.name.to_lower() == lower { return h.value }
    }
    return null
}

fun _require_header(headers: Header[], name: string) {
    if let value = _find_header(headers, name) {
        return value
    }
    error("missing header: {name}")!
}

fun _parse_header_lines(text: string) {
    let headers: Header[] = []
    for line in text.split("\r\n") {
        if len(line) > 0 {
            let [name, val] = _split_once(line, ":")!
            if !_is_token(name) {
                return error("invalid HTTP header name: {name}")
            }
            if !_is_field_value(val) {
                return error("invalid HTTP header value for {name}")
            }
            const value = val.trim()
            headers.push(Header { name: name, value: value })
        }
    }
    return headers
}

fun _parse_head(text: string, kind: string) {
    const lines = text.split("\r\n")
    if len(lines) == 0 { error("empty {kind}")! }
    const header_text = lines.slice(1, len(lines)).join("\r\n")
    return _HttpHead {
        line: lines[0],
        headers: _parse_header_lines(header_text)!,
    }
}

fun _parse_message(raw: string, kind: string) {
    const [head, body_text] = _split_once(raw, "\r\n\r\n")!
    return _HttpMessage {
        head: _parse_head(head, kind)!,
        body: to_bytes(body_text),
    }
}

fun _parse_status_line(line: string) {
    const parts = line.split(" ")
    if len(parts) < 2 { error("invalid status line")! }
    if !_is_http_version(parts[0]) || len(parts[1]) != 3 || !_is_digits(parts[1]) {
        error("invalid status line")!
    }
    let reason = ""
    if len(parts) >= 3 {
        reason = parts.slice(2, len(parts)).join(" ")
    }
    if !_is_field_value(reason) {
        error("invalid reason phrase")!
    }
    return _StatusLine {
        version: parts[0],
        status: int32.parse(parts[1])!,
        reason: reason,
    }
}

fun _is_token(s: string) -> bool {
    if len(s) == 0 {
        return false
    }
    for b in to_bytes(s) {
        const alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
        const digit = b >= 48 && b <= 57
        const punct = b == 33 || b == 35 || b == 36 || b == 37 || b == 38 ||
            b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 ||
            b == 95 || b == 96 || b == 124 || b == 126
        if !alpha && !digit && !punct {
            return false
        }
    }
    return true
}

fun _is_field_value(s: string) -> bool {
    for b in to_bytes(s) {
        if (b < 32 && b != 9) || b == 127 {
            return false
        }
    }
    return true
}

fun _is_http_version(s: string) -> bool {
    const b = to_bytes(s)
    return len(b) == 8 && b[0] == 72 && b[1] == 84 && b[2] == 84 &&
        b[3] == 80 && b[4] == 47 && b[5] >= 48 && b[5] <= 57 &&
        b[6] == 46 && b[7] >= 48 && b[7] <= 57
}

fun _is_request_target(s: string) -> bool {
    if len(s) == 0 {
        return false
    }
    for b in to_bytes(s) {
        if b <= 32 || b >= 127 {
            return false
        }
    }
    return true
}

fun _is_digits(s: string) -> bool {
    if len(s) == 0 {
        return false
    }
    for b in to_bytes(s) {
        if b < 48 || b > 57 {
            return false
        }
    }
    return true
}

fun _serialize_message(line: string, headers: Header[], body: uint8[]) -> uint8[] {
    let text = "{line}\r\n"
    for h in headers {
        text = "{text}{h.name}: {h.value}\r\n"
    }
    text = "{text}\r\n"
    let bytes = to_bytes(text)
    for b in body { bytes.push(b) }
    return bytes
}

// --- HttpRequest ---

/** Parses a raw HTTP/1.x request string. */
fun HttpRequest.parse(raw: string) {
    const message = _parse_message(raw, "request")!
    const parts = message.head.line.split(" ")
    if len(parts) != 3 || !_is_token(parts[0]) || !_is_request_target(parts[1]) ||
       !_is_http_version(parts[2]) {
        error("invalid request line")!
    }
    return Self {
        method: parts[0],
        path: parts[1],
        version: parts[2],
        headers: message.head.headers,
        body: message.body,
    }
}

/** Serializes this request into raw bytes for sending over TCP. */
fun HttpRequest.serialize(self) -> uint8[] {
    return _serialize_message("{self.method} {self.path} {self.version}", self.headers, self.body)
}

// --- HttpResponse ---

/**
 * Parses a raw HTTP/1.x response string.
 *
 * The body is framed by the headers: a `Transfer-Encoding: chunked` body is
 * decoded (chunked takes precedence over `Content-Length`; any other
 * transfer coding is an error), a `Content-Length` body is cut to that
 * length, and informational, 204, and 304 responses are bodyless. The
 * headers are kept exactly as received, even when the body was de-chunked.
 */
fun HttpResponse.parse(raw: string) {
    const message = _parse_message(raw, "response")!
    const status = _parse_status_line(message.head.line)!
    const body = _framed_parsed_body(status.status, message.head.headers, message.body)!
    return Self {
        version: status.version,
        status: status.status,
        reason: status.reason,
        headers: message.head.headers,
        body: body,
    }
}

/**
 * Serializes this response into raw bytes, as a server writes them onto the
 * connection: the status line, the headers, a blank line, then the body.
 *
 * The headers are written exactly as they stand -- nothing is added, so a
 * `Content-Length` (or a `Transfer-Encoding`, with a body already in chunked
 * form) is the caller's business, as it is for `HttpRequest.serialize`.
 * Parsing the result yields an equal response when the framing headers
 * describe the body as written.
 *
 * The status line keeps the space before the reason phrase even when the reason
 * is empty (`HTTP/1.1 204 `): the grammar asks for it, and it is what lets
 * `parse` read the line back.
 */
fun HttpResponse.serialize(self) -> uint8[] {
    return _serialize_message(
        "{self.version} {self.status} {self.reason}",
        self.headers,
        self.body,
    )
}

/** Returns the response body decoded as a UTF-8 string. */
fun HttpResponse.body_text(self) {
    return to_text(self.body)
}

// --- HttpClient ---

// _connect is unannotated: accepts any () -> conn! closure.
// Tcp and TlsStream are structurally compatible (read/write/close),
// so a single type handles both protocols.
type HttpClient = {
    host: string
    port: int32
    _default_port: int32
    _connect
}

fun HttpClient.http(host: string, port: int32) {
    return Self {
        host: host,
        port: port,
        _default_port: 80,
        _connect: () -> { return Tcp.connect(host, port) },
    }
}

fun HttpClient.https(host: string, port: int32) {
    return Self {
        host: host,
        port: port,
        _default_port: 443,
        _connect: () -> { return TlsStream.connect(host, port) },
    }
}

// conn is structurally typed: works with both Tcp and TlsStream.
// Response framing, in order: HEAD and bodyless statuses yield an empty
// body; a chunked body is decoded up to its terminator (taking precedence
// over Content-Length); else Content-Length bytes are read; else the body
// runs to connection close.
fun _read_response_open(conn, req: HttpRequest) {
    conn.write(req.serialize())!

    let data: uint8[] = []
    let header_end: int64 = -1

    while header_end < 0 {
        let chunk = conn.read(4096)!
        if len(chunk) == 0 { error("connection closed before headers complete")! }
        for b in chunk { data.push(b) }
        let pos = _find_header_end(data)
        if pos { header_end = pos }
    }

    let header_bytes = data.slice(0, header_end)
    let header_text = to_text(header_bytes)!
    const head = _parse_head(header_text, "response")!
    const status = _parse_status_line(head.line)!
    const headers = head.headers

    const body_start = header_end + 4
    const content_length = _content_length(headers)!
    const no_body = req.method == "HEAD" || _status_has_no_body(status.status)

    if no_body {
        return HttpResponse {
            version: status.version,
            status: status.status,
            reason: status.reason,
            headers: headers,
            body: [],
        }
    }

    // Checked only when a body follows: a HEAD response carries the framing
    // headers of the GET it mirrors, so an unsupported coding there is not
    // this exchange's problem.
    if _is_chunked(headers)! {
        const body = _read_chunked_body(conn, data.slice(body_start, len(data)))!
        return HttpResponse {
            version: status.version,
            status: status.status,
            reason: status.reason,
            headers: headers,
            body: body,
        }
    }

    if let expected = content_length {
        while len(data) - body_start < expected {
            let chunk = conn.read(4096)!
            if len(chunk) == 0 { error("connection closed before body complete")! }
            for b in chunk { data.push(b) }
        }
    } else {
        let reading = true
        while reading {
            const value = conn.read(4096)!
            if len(value) == 0 { reading = false }
            else { for b in value { data.push(b) } }
        }
    }

    let body_end = len(data)
    if let expected = content_length {
        body_end = body_start + expected
    }

    return HttpResponse {
        version: status.version,
        status: status.status,
        reason: status.reason,
        headers: headers,
        body: data.slice(body_start, body_end),
    }
}

// Close exactly once after every attempted exchange. A response/read error is
// kept as the primary failure; otherwise a close failure is propagated.
fun _read_response(conn, req: HttpRequest) {
    const result = _read_response_open(conn, req)
    match result {
        Err { error } => {
            match conn.close() {
                Ok { value } => {}
                Err { error } => {}
            }
            return result
        }
        Ok { value } => {
            conn.close()!
            return value
        }
    }
}

fun _status_has_no_body(status: int32) -> bool {
    return (status >= 100 && status < 200) || status == 204 || status == 304
}

fun _content_length(headers: Header[]) -> int64?! {
    let found: int64? = null
    for h in headers {
        if h.name.to_lower() == "content-length" {
            for raw in h.value.split(",") {
                const value = raw.trim()
                if !_is_digits(value) {
                    return error("invalid Content-Length: {h.value}")
                }
                const parsed = int64.parse(value)!
                if let previous = found {
                    if previous != parsed {
                        return error("conflicting Content-Length headers")
                    }
                } else {
                    found = parsed
                }
            }
        }
    }
    return found
}

// Whether the message body uses chunked transfer framing. `chunked` is the
// only transfer coding this module decodes, so any other coding -- alone or
// layered under chunked -- is an error rather than a body we would silently
// hand back still encoded. When chunked framing applies it takes precedence
// over `Content-Length` (RFC 9112 section 6.3). Every `Transfer-Encoding`
// header contributes, comma-separated, like `_content_length`.
fun _is_chunked(headers: Header[]) -> bool! {
    let codings: string[] = []
    for h in headers {
        if h.name.to_lower() == "transfer-encoding" {
            for raw in h.value.split(",") {
                const coding = raw.trim().to_lower()
                if len(coding) > 0 { codings.push(coding) }
            }
        }
    }
    if len(codings) == 0 { return false }
    if len(codings) == 1 && codings[0] == "chunked" { return true }
    const joined = codings.join(", ")
    return error("unsupported Transfer-Encoding: {joined}")
}

// Index of the CR of the first CRLF at or after `from`, or -1 when the data
// ends first (the sentinel keeps the index usable in arithmetic directly).
fun _find_crlf(data: uint8[], from: int64) -> int64 {
    let i = from
    while i + 1 < len(data) {
        if data[i] == 13 && data[i + 1] == 10 { return i }
        i += 1
    }
    return -1
}

// Parses the hex chunk size in bytes [from, line_end) of a chunk header line.
// A chunk extension (";" and what follows) is ignored, and a space or tab also
// ends the size, tolerating servers that pad it. Thirteen significant hex
// digits bound the size (leading zeros are free) so the arithmetic stays well
// inside int64.
fun _parse_chunk_size(data: uint8[], from: int64, line_end: int64) -> int64! {
    let size: int64 = 0
    let digits = 0
    let significant = 0
    let i = from
    let scanning = true
    while scanning && i < line_end {
        const b = data[i]
        if b == 59 || b == 32 || b == 9 {
            scanning = false
        } else {
            let digit: int64 = -1
            if b >= 48 && b <= 57 { digit = b - 48 }
            if b >= 97 && b <= 102 { digit = b - 87 }
            if b >= 65 && b <= 70 { digit = b - 55 }
            if digit < 0 { return error("invalid chunk size") }
            digits += 1
            if size > 0 || digit > 0 {
                if significant >= 13 { return error("chunk size too large") }
                size = size * 16 + digit
                significant += 1
            }
            i += 1
        }
    }
    if digits == 0 { return error("invalid chunk size") }
    return size
}

// Offset just past the trailer section starting at `from` -- zero or more
// field lines, then the empty line ending the coding -- or -1 when `data`
// ends before that. Trailer fields are consumed for framing and discarded.
fun _scan_trailers(data: uint8[], from: int64) -> int64 {
    let pos = from
    let scanning = true
    while scanning {
        const line_end = _find_crlf(data, pos)
        if line_end < 0 { return -1 }
        if line_end == pos { scanning = false }
        pos = line_end + 2
    }
    return pos
}

// One pass of the chunked transfer coding (RFC 9112 section 7.1) at the
// start of `data`: decodes the complete chunks there, stopping cleanly at an
// incomplete tail. `body` is their concatenated payload, `consumed` how many
// leading bytes those whole chunks took, and `done` whether the zero-size
// terminator and its trailer section were reached -- so a caller may demand
// completeness (`_decode_chunked`) or drop the consumed prefix and read on
// (`_read_chunked_body`) without rescanning what it already decoded. Only
// malformed framing is an error; an incomplete tail is not.
fun _scan_chunks(data: uint8[]) -> _ChunkScan! {
    let body: uint8[] = []
    let consumed: int64 = 0
    let scanning = true
    while scanning {
        const size_end = _find_crlf(data, consumed)
        if size_end < 0 { scanning = false }
        else {
            const size = _parse_chunk_size(data, consumed, size_end)!
            const chunk_start = size_end + 2
            if size == 0 {
                const end = _scan_trailers(data, chunk_start)
                if end >= 0 {
                    return _ChunkScan { body: body, consumed: end, done: true }
                }
                scanning = false
            } else {
                if len(data) < chunk_start + size + 2 { scanning = false }
                else {
                    if data[chunk_start + size] != 13 || data[chunk_start + size + 1] != 10 {
                        return error("malformed chunk: no CRLF after chunk data")
                    }
                    for i in [chunk_start..chunk_start + size] { body.push(data[i]) }
                    consumed = chunk_start + size + 2
                }
            }
        }
    }
    return _ChunkScan { body: body, consumed: consumed, done: false }
}

// Decodes a chunked body held in memory whole, as `HttpResponse.parse` has
// it. A body that ends before the terminating chunk is an error here, where
// the streaming client would read on instead. Bytes past the terminator are
// ignored.
fun _decode_chunked(data: uint8[]) -> uint8[]! {
    const scan = _scan_chunks(data)!
    if scan.done { return scan.body }
    return error("truncated chunked body")
}

// Reads a chunked response body from the connection: `data` holds whatever
// arrived past the header block, and more is read until the terminating
// chunk and its trailer section are complete. Whole chunks are dropped from
// the buffer as they are decoded, so a body of many chunks is not rescanned
// once per read; an incomplete single chunk costs each pass only its size
// line, so that case stays linear too. Returns the decoded payload.
fun _read_chunked_body(conn, data: uint8[]) -> uint8[]! {
    let body: uint8[] = []
    let waiting = true
    while waiting {
        const scan = _scan_chunks(data)!
        for b in scan.body { body.push(b) }
        if scan.done { return body }
        if scan.consumed > 0 { data = data.slice(scan.consumed, len(data)) }
        const chunk = conn.read(4096)!
        if len(chunk) == 0 { waiting = false }
        else { for b in chunk { data.push(b) } }
    }
    return error("connection closed inside chunked body")
}

fun _framed_parsed_body(status: int32, headers: Header[], body: uint8[]) -> uint8[]! {
    const content_length = _content_length(headers)!
    if _status_has_no_body(status) {
        let empty: uint8[] = []
        return empty
    }
    // Checked only when a body follows, so a bodyless status is returned
    // whole even under a transfer coding this module cannot decode.
    if _is_chunked(headers)! {
        return _decode_chunked(body)!
    }
    if let expected = content_length {
        if len(body) < expected {
            return error("response body is shorter than Content-Length")
        }
        return body.slice(0, expected)
    }
    return body
}

fun HttpClient.request(self, req: HttpRequest) {
    let conn = self._connect()!
    return _read_response(conn, req)
}

fun HttpClient.fetch(self, path: string) {
    let host_str = self.host
    if self.host.find(":") != null && !self.host.starts_with("[") {
        host_str = "[{self.host}]"
    }
    if self.port != self._default_port {
        host_str = "{self.host}:{self.port}"
    }
    let req = HttpRequest {
        method: "GET",
        path: path,
        version: "HTTP/1.1",
        headers: [Header { name: "Host", value: host_str }],
        body: [],
    }
    return self.request(req)
}

// --- convenience functions ---

/** Sends the request via plain HTTP. Requires a Host header. */
fun request(req: HttpRequest) {
    let host_value = _require_header(req.headers, "Host")!
    const authority = _parse_host_port(host_value, 80)!
    let client = HttpClient.http(authority.host, authority.port)
    return client.request(req)
}

fun _parse_host_port(value: string, default_port: int32) -> _HostPort! {
    const text = value.trim()
    if len(text) == 0 {
        return error("empty Host header")
    }
    if text.starts_with("[") {
        if let close = text.find("]") {
            if close == 1 {
                return error("malformed bracketed host: {text}")
            }
            const host = _string_slice(text, 1, close)
            const rest = _string_slice(text, close + 1, len(text))
            if len(rest) == 0 {
                return _HostPort { host: host, port: default_port }
            }
            if !rest.starts_with(":") || len(rest) == 1 {
                return error("malformed bracketed host: {text}")
            }
            return _HostPort {
                host: host,
                port: _parse_port(_string_slice(rest, 1, len(rest)))!,
            }
        }
        return error("malformed bracketed host: {text}")
    }
    const parts = text.split(":")
    if len(parts) > 2 || len(parts[0]) == 0 {
        return error("malformed Host header: {text}")
    }
    if len(parts) == 2 {
        return _HostPort { host: parts[0], port: _parse_port(parts[1])! }
    }
    return _HostPort { host: parts[0], port: default_port }
}

fun _parse_port(text: string) -> int32! {
    if !_is_digits(text) {
        return error("invalid port: {text}")
    }
    const port = int64.parse(text)!
    if port < 0 || port > 65535 {
        return error("port out of range: {text}")
    }
    return int32.from(port)!
}

/** How many redirects `fetch` follows before it gives up. */
const MAX_REDIRECTS = 10

/**
 * GETs the given URL (http:// or https://), following redirects, and returns the
 * response.
 *
 * A 3xx carrying a `Location` is followed, up to `MAX_REDIRECTS` hops; the header
 * is resolved against the URL it came from, so a relative `Location` (`/next`,
 * `../next`) works as well as an absolute one, and a hop may cross schemes or
 * hosts. The chain stays a GET: `fetch` sends no body, so the method rewrite RFC
 * 9110 prescribes for 301/302/303 is a no-op here, and 307/308 preserve the
 * method anyway.
 *
 * A 3xx with NO `Location` is returned as it stands rather than treated as a
 * failure -- a 304 (not modified) or a 300 (multiple choices) is an answer, not
 * a hop.
 */
fun fetch(url_str: string) {
    let uri = URI.parse(url_str)!
    let hops = 0
    while hops <= MAX_REDIRECTS {
        let response = _fetch_uri(uri)!
        if !_is_redirect(response.status) {
            return response
        }
        if let location = _find_header(response.headers, "Location") {
            uri = uri.resolve(location)!
            hops += 1
        } else {
            return response
        }
    }
    error("too many redirects ({MAX_REDIRECTS}) following {url_str}")!
}

// The redirects that name a new target in `Location`. 300 and 304 are 3xx too,
// but neither is a hop, so they are deliberately absent.
fun _is_redirect(status: int32) -> bool {
    return status == 301 || status == 302 || status == 303 ||
           status == 307 || status == 308
}

// One GET of an already-parsed URL. The scheme picks the transport and the
// default port; an explicit port overrides it.
fun _fetch_uri(uri: URI) {
    let scheme = ""
    if let s = uri.scheme {
        scheme = s
    } else {
        return error("unsupported URL scheme")
    }
    if scheme != "http" && scheme != "https" {
        return error("unsupported URL scheme")
    }
    const is_https = scheme == "https"

    let path = uri.path
    if len(path) == 0 { path = "/" }
    let q = uri.query
    if q { path = "{path}?{q}" }

    let auth = uri.authority
    if auth {
        let host = auth.host
        if host.starts_with("[") {
            host = _string_slice(host, 1, len(host) - 1)
        }
        let port = 80
        if is_https { port = 443 }
        let p = auth.port
        if p { port = int32.from(p)! }

        if is_https {
            let client = HttpClient.https(host, port)
            return client.fetch(path)
        }
        let client = HttpClient.http(host, port)
        return client.fetch(path)
    }
    let url_str = uri.to_string()
    error("URL has no authority: {url_str}")!
}
