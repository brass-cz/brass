import std.collections.{ HashMap }

// JSON: a value tree, a recursive-descent parser, accessors, a serializer, and
// a reflective decoder into typed structures. A library (pure Brass, no
// plugin) -- import it explicitly:
//
//     import data.json.{ JsonValue }
//
// The value tree mirrors the six JSON kinds. An Object keeps its members in a
// string -> JsonValue `HashMap` (the `_JsonObject` refinement below pins the
// slots), so `get` is a hash lookup. One consequence: `stringify` renders
// object members in the map's slot order, not insertion order -- stable for a
// given input, but not the source document's ordering.

type _JsonObject = HashMap { key: string, value: JsonValue }
type _StringMap = HashMap { key: string }
type _JsonConvertible = {
    to_json(self) -> JsonValue!
}

/**
 * A parsed JSON value, one variant per JSON kind. Obtain one with `JsonValue.parse`,
 * inspect it with the accessors (`get`, `at`, `as_*`), decode it into a typed
 * structure with `into`, or construct one from a value with `from`. Render
 * compact text with `stringify` or indented text with `pretty` / `display`.
 */
type JsonValue =
    | Null
    | Bool { value: bool }
    | Number { value: float64 }
    | String { value: string }
    | Array { value: JsonValue[] }
    | Object { values: _JsonObject }

// ----- accessors -----

/** The boolean inside a `Bool`, or an error for any other kind. */
fun JsonValue.as_bool(self) -> bool! {
    match self {
        JsonValue.Bool { value } => {
            return value
        },
        _ => {
        },
    }
    return error("expected a JSON boolean")
}

/** The number inside a `Number`, or an error for any other kind. */
fun JsonValue.as_number(self) -> float64! {
    match self {
        JsonValue.Number { value } => {
            return value
        },
        _ => {
        },
    }
    return error("expected a JSON number")
}

/** The string inside a `String`, or an error for any other kind. */
fun JsonValue.as_string(self) -> string! {
    match self {
        JsonValue.String { value } => {
            return value
        },
        _ => {
        },
    }
    return error("expected a JSON string")
}

/** Whether this value is JSON `null`. */
fun JsonValue.is_null(self) -> bool {
    match self {
        JsonValue.Null => {
            return true
        },
        _ => {
        },
    }
    return false
}

/** The value of object field `key`, or an error naming the missing field. */
fun JsonValue.get(self, key: string) -> JsonValue! {
    match self {
        JsonValue.Object { values } => {
            if let v = values.get(key) {
                return v
            }
            return error("missing field '{key}'")
        },
        _ => {
        },
    }
    return error("expected a JSON object")
}

/** The element at `index` of an array, or an error when out of range. */
fun JsonValue.at(self, index: int64) -> JsonValue! {
    match self {
        JsonValue.Array { value } => {
            if index >= 0 && index < len(value) {
                return value[index]
            }
            return error("array index {index} out of range")
        },
        _ => {
        },
    }
    return error("expected a JSON array")
}

// ----- reflective decoding -----

/**
 * Decode `self` into the type the call site expects, driven entirely by that
 * target type: `const u: User = j.into()!`. A scalar target reads the
 * matching JSON scalar; a record target walks its own fields (each decoded
 * recursively); a nullable target accepts JSON null, and a nullable field
 * also accepts an absent member. A JSON value of the wrong kind for the
 * target, or an absent member for a non-nullable field, is a runtime decode
 * error.
 */
fun JsonValue.into(self) -> infer! {
    match self {
        JsonValue.Number { value } => {
            return infer.from(value)
        },
        JsonValue.String { value } => {
            return infer.from(value)
        },
        JsonValue.Bool { value } => {
            return infer.from(value)
        },
        JsonValue.Null => {
            return null
        },
        JsonValue.Object { values } => {
            let ret: infer
            for field in fields(ret) {
                if let member = values.get(field) {
                    ret[field] = member.into()!
                } else {
                    // An absent member reads as JSON null: a nullable field
                    // decodes it as null, any other field reports the miss.
                    const absent = JsonValue.Null
                    match absent.into() {
                        Ok { value } => {
                            ret[field] = value
                        },
                        Err { error } => {
                            return error("missing field '{field}'")
                        },
                    }
                }
            }
            return ret
        },
        JsonValue.Array { value } => {
            return error("cannot decode a JSON array into a scalar or record")
        },
    }
}

// ----- conversion to JSON -----

/**
 * Convert a value to a JSON tree. JsonValue passes through unchanged; a declared
 * `to_json(self) -> JsonValue!` supplies a custom conversion. Booleans, numbers,
 * strings, nullables, arrays, string-keyed HashMaps and records convert
 * recursively. Record fields become object members; map entries are inserted
 * in map order. Object output order is unspecified.
 *
 * Recursive record conversion uses compile-time field reflection. The compiler
 * permits at most eight additional active recursive instances with distinct
 * concrete types; deeper expansion is a compile-time error at the fields loop.
 *
 * Numbers become float64, so integers beyond 2^53 can lose precision.
 * Non-finite numbers and unsupported types (including non-string map keys,
 * sums without a hook and functions) return an error without a partial tree.
 */
fun JsonValue.from(value) -> JsonValue! {
    return _from(value)
}

fun _from(value) -> JsonValue! {
    if value: JsonValue {
        return value
    } else if value: _JsonConvertible {
        return value.to_json()
    } else if value: bool {
        return JsonValue.Bool { value }
    } else if value: string {
        return JsonValue.String { value }
    } else if value: infer? {
        if let inner = value {
            return _from(inner)
        }
        return JsonValue.Null
    } else if value: infer[] {
        let elements: JsonValue[] = []
        for element in value {
            elements.push(_from(element)!)
        }
        return JsonValue.Array { value: elements }
    } else if value: _StringMap {
        let members: _JsonObject = HashMap.new()
        for key in value.keys() {
            // Every key is present; get's null represents a stored nullable value.
            members.set(key, _from(value.get(key))!)
        }
        return JsonValue.Object { values: members }
    } else if value: HashMap {
        return error(
            "cannot convert {typeof(value)} with non-string keys to JSON",
        )
    } else if value: anonymous {  } {
        let members: _JsonObject = HashMap.new()
        for field in fields(value) {
            members.set(field, _from(value[field])!)
        }
        return JsonValue.Object { values: members }
    } else if value: int8 {
        return _number(float64.from(value))
    } else if value: int16 {
        return _number(float64.from(value))
    } else if value: int32 {
        return _number(float64.from(value))
    } else if value: int64 {
        return _number(float64.from(value))
    } else if value: uint8 {
        return _number(float64.from(value))
    } else if value: uint16 {
        return _number(float64.from(value))
    } else if value: uint32 {
        return _number(float64.from(value))
    } else if value: uint64 {
        return _number(float64.from(value))
    } else if value: float32 {
        return _number(float64.from(value))
    } else if value: float64 {
        return _number(float64.from(value))
    }
    return error("cannot convert {typeof(value)} to JSON")
}

fun _number(value: float64) -> JsonValue! {
    if value != value || value - value != 0.0 {
        return error("JSON number is not finite: {value}")
    }
    return JsonValue.Number { value }
}

// ----- serialization -----
//
// The rendering methods delegate recursion to `_render`. Keeping the hot
// recursive core a free function is a compile-time choice: a method call on a sum
// resolves to one candidate per variant and the checker re-elaborates each, so a
// recursive method multiplies its own work by the variant count. The public
// surface is unaffected -- callers write `j.stringify()` either way.

/** Render compact JSON without added whitespace. Finite integral numbers within
 * +/-2^53 use integer spelling, including negative zero as `0`; other numbers
 * retain their float spelling. `pretty`, `display` and `debug` use the same rule.
 */
fun JsonValue.stringify(self) -> string {
    return _render(self, false)
}

/**
 * Render JSON with four-space indentation and one member or element per line.
 * Empty objects and arrays stay inline. Strings and numbers render exactly as
 * in `stringify`; object order is unspecified.
 */
fun JsonValue.pretty(self) -> string {
    return _render(self, true)
}

/** Render the same multi-line JSON text as `pretty`, including in interpolation. */
fun JsonValue.display(self) -> string {
    return _render(self, true)
}

// The recursive renderer. See the note above on why this is not a method.
fun _render(value: JsonValue, pretty: bool) -> string {
    match value {
        JsonValue.Null => {
            return "null"
        },
        JsonValue.Bool { value } => {
            if value {
                return "true"
            }
            return "false"
        },
        JsonValue.Number { value } => {
            // Within the exact-integer range the conversion and comparison are lossless.
            if value >= -9007199254740992.0 && value <= 9007199254740992.0 {
                if let Ok { value: integer } = int64.from(value) {
                    if float64.from(integer) == value {
                        return "{integer}"
                    }
                }
            }
            return "{value}"
        },
        JsonValue.String { value } => {
            return _quote(value)
        },
        JsonValue.Array { value } => {
            let parts: string[] = []
            for elem in value {
                parts.push(_render(elem, pretty))
            }
            return _join(parts, "[", "]", pretty)
        },
        JsonValue.Object { values } => {
            let parts: string[] = []
            let colon = ":"
            if pretty {
                colon = ": "
            }
            for k in values.keys() {
                if let v = values.get(k) {
                    parts.push(_quote(k) + colon + _render(v, pretty))
                }
            }
            return _join(parts, "\{", "\}", pretty)
        },
    }
}

// Wrap a string in double quotes with the JSON escapes the parser accepts.
// Iterated by byte index rather than `s.chars()`: building an inferred `[]` per
// character, once per string rendered, is wasted work when a byte walk answers
// the same question.
fun _quote(s: string) -> string {
    let out = "\""
    let i: int64 = 0
    while i < len(s) {
        if let ch = _string_char_at(s, i) {
            if ch == "\"" {
                out = out + "\\\""
            } else if ch == "\\" {
                out = out + "\\\\"
            } else if ch == _byte_char(8) {
                out = out + "\\b"
            } else if ch == _byte_char(12) {
                out = out + "\\f"
            } else if ch == "\n" {
                out = out + "\\n"
            } else if ch == "\t" {
                out = out + "\\t"
            } else if ch == "\r" {
                out = out + "\\r"
            } else if _is_control(ch) {
                const b = to_bytes(ch)[0]
                out = out + "\\u00{_hex_digit(b / 16)}{_hex_digit(b % 16)}"
            } else {
                out = out + ch
            }
            i = i + len(ch)
        } else {
            i = i + 1
        }
    }
    return out + "\""
}

// ----- parsing -----
//
// A single-pass recursive-descent parser. `_Cursor` carries the text and the
// current byte offset; its methods advance it. `JsonValue.parse` requires the
// whole input to be one JSON value (trailing content is an error).

type _Cursor = {
    text: string
    pos: int64
}

/**
 * Parse `text` as one JSON value. The whole input must be consumed: trailing
 * content is an error.
 */
fun JsonValue.parse(text: string) -> JsonValue! {
    let cur = _Cursor { text, pos: 0 }
    cur._skip_ws()
    const value = cur._value()!
    cur._skip_ws()
    if cur.pos != len(cur.text) {
        return error("unexpected trailing characters at offset {cur.pos}")
    }
    return value
}

fun _Cursor._peek(self) -> string {
    if self.pos >= len(self.text) {
        return ""
    }
    if let c = _string_char_at(self.text, self.pos) {
        return c
    }
    return ""
}

fun _Cursor._starts_with_here(self, value: string) -> bool {
    const end = self.pos + len(value)
    if end > len(self.text) {
        return false
    }
    return _string_slice(self.text, self.pos, end) == value
}

fun _Cursor._skip_ws(self) {
    while self.pos < len(self.text) {
        const c = self._peek()
        if c == " " || c == "\n" || c == "\t" || c == "\r" {
            self.pos = self.pos + 1
        } else {
            return
        }
    }
}

fun _Cursor._value(self) -> JsonValue! {
    const c = self._peek()
    if c == "\{" {
        return self._object()!
    }
    if c == "[" {
        return self._array()!
    }
    if c == "\"" {
        return JsonValue.String { value: self._string()! }
    }
    if c == "t" || c == "f" {
        return self._bool()!
    }
    if c == "n" {
        return self._null()!
    }
    return self._number()
}

fun _Cursor._object(self) -> JsonValue! {
    self.pos = self.pos + 1
    let values: _JsonObject = HashMap.new()
    self._skip_ws()
    if self._peek() == "\}" {
        self.pos = self.pos + 1
        return JsonValue.Object { values }
    }
    while true {
        self._skip_ws()
        const key = self._string()!
        self._skip_ws()
        if self._peek() != ":" {
            return error("expected ':' in object at offset {self.pos}")
        }
        self.pos = self.pos + 1
        self._skip_ws()
        const val = self._value()!
        values.set(key, val)
        self._skip_ws()
        const sep = self._peek()
        self.pos = self.pos + 1
        if sep == "\}" {
            return JsonValue.Object { values }
        }
        if sep != "," {
            return error("expected ',' or '\}' in object at offset {self.pos}")
        }
    }
    return error("unterminated object")
}

fun _Cursor._array(self) -> JsonValue! {
    self.pos = self.pos + 1
    let items: JsonValue[] = []
    self._skip_ws()
    if self._peek() == "]" {
        self.pos = self.pos + 1
        return JsonValue.Array { value: items }
    }
    while true {
        self._skip_ws()
        const val = self._value()!
        items.push(val)
        self._skip_ws()
        const sep = self._peek()
        self.pos = self.pos + 1
        if sep == "]" {
            return JsonValue.Array { value: items }
        }
        if sep != "," {
            return error("expected ',' or ']' in array at offset {self.pos}")
        }
    }
    return error("unterminated array")
}

fun _Cursor._string(self) -> string! {
    if self._peek() != "\"" {
        return error("expected a string at offset {self.pos}")
    }
    self.pos = self.pos + 1
    let out = ""
    while self.pos < len(self.text) {
        const c = self._peek()
        self.pos = self.pos + len(c)
        if c == "\"" {
            return out
        }
        if c == "\\" {
            const esc = self._peek()
            self.pos = self.pos + 1
            if esc == "\"" {
                out = out + "\""
            } else if esc == "\\" {
                out = out + "\\"
            } else if esc == "/" {
                out = out + "/"
            } else if esc == "n" {
                out = out + "\n"
            } else if esc == "t" {
                out = out + "\t"
            } else if esc == "r" {
                out = out + "\r"
            } else if esc == "b" {
                out = out + _byte_char(8)
            } else if esc == "f" {
                out = out + _byte_char(12)
            } else if esc == "u" {
                out = out + self._unicode_escape()!
            } else {
                return error("invalid escape in string at offset {self.pos}")
            }
        } else {
            if _is_control(c) {
                return error(
                    "raw control character in string at offset {self.pos}",
                )
            }
            out = out + c
        }
    }
    return error("unterminated string")
}

fun _Cursor._number(self) -> JsonValue! {
    const start = self.pos
    if self._peek() == "-" {
        self.pos += 1
    }
    if self._peek() == "0" {
        self.pos += 1
        if _is_digit(self._peek()) {
            return error("leading zero in JSON number at offset {self.pos}")
        }
    } else {
        if !_is_nonzero_digit(self._peek()) {
            return error("invalid JSON number at offset {self.pos}")
        }
        while _is_digit(self._peek()) {
            self.pos += 1
        }
    }
    if self._peek() == "." {
        self.pos += 1
        if !_is_digit(self._peek()) {
            return error("missing fraction digits at offset {self.pos}")
        }
        while _is_digit(self._peek()) {
            self.pos += 1
        }
    }
    const exponent = self._peek()
    if exponent == "e" || exponent == "E" {
        self.pos += 1
        const sign = self._peek()
        if sign == "+" || sign == "-" {
            self.pos += 1
        }
        if !_is_digit(self._peek()) {
            return error("missing exponent digits at offset {self.pos}")
        }
        while _is_digit(self._peek()) {
            self.pos += 1
        }
    }
    const raw = _string_slice(self.text, start, self.pos)
    const value = float64.parse(raw)!
    if value != value || value - value != 0.0 {
        return error("JSON number is not finite: {raw}")
    }
    return JsonValue.Number { value }
}

fun _is_digit(c: string) -> bool {
    return c == "0" ||
        c == "1" ||
        c == "2" ||
        c == "3" ||
        c == "4" ||
        c == "5" ||
        c == "6" ||
        c == "7" ||
        c == "8" ||
        c == "9"
}

fun _is_nonzero_digit(c: string) -> bool {
    return _is_digit(c) && c != "0"
}

fun _Cursor._bool(self) -> JsonValue! {
    if self._starts_with_here("true") {
        self.pos = self.pos + 4
        return JsonValue.Bool { value: true }
    }
    if self._starts_with_here("false") {
        self.pos = self.pos + 5
        return JsonValue.Bool { value: false }
    }
    return error("invalid literal at offset {self.pos}")
}

fun _Cursor._null(self) -> JsonValue! {
    if self._starts_with_here("null") {
        self.pos = self.pos + 4
        return JsonValue.Null
    }
    return error("invalid literal at offset {self.pos}")
}

// Decode one JSON UTF-16 escape, combining a required low surrogate after a
// high surrogate and rejecting lone surrogate code units.
fun _Cursor._unicode_escape(self) -> string! {
    let cp = self._hex4()!
    if cp >= 55296 && cp <= 56319 {
        if !self._starts_with_here("\\u") {
            return error("high surrogate is not followed by a low surrogate")
        }
        self.pos += 2
        const low = self._hex4()!
        if low < 56320 || low > 57343 {
            return error("invalid low surrogate in JSON string")
        }
        cp = 65536 + (cp - 55296) * 1024 + (low - 56320)
    } else if cp >= 56320 && cp <= 57343 {
        return error("lone low surrogate in JSON string")
    }
    return _encode_utf8(cp)!
}

fun _Cursor._hex4(self) -> int64! {
    let value: int64 = 0
    let i: int64 = 0
    while i < 4 {
        const digit = _hex_value(self._peek())
        if digit < 0 {
            return error("invalid unicode escape at offset {self.pos}")
        }
        value = value * 16 + digit
        self.pos += 1
        i += 1
    }
    return value
}

fun _hex_value(c: string) -> int64 {
    const b = to_bytes(c)
    if len(b) != 1 {
        return -1
    }
    if b[0] >= 48 && b[0] <= 57 {
        return b[0] - 48
    }
    if b[0] >= 65 && b[0] <= 70 {
        return b[0] - 55
    }
    if b[0] >= 97 && b[0] <= 102 {
        return b[0] - 87
    }
    return -1
}

fun _hex_digit(value: int64) -> string {
    if value < 10 {
        return string.from(value)
    }
    return ["A", "B", "C", "D", "E", "F"][value - 10]
}

fun _is_control(c: string) -> bool {
    const bytes = to_bytes(c)
    return len(bytes) == 1 && bytes[0] < 32
}

fun _u8(value: int64) -> uint8 {
    match uint8.from(value) {
        Ok { value } => {
            return value
        },
        Err { error } => {
            return 0
        },
    }
}

fun _byte_char(value: int64) -> string {
    let bytes: uint8[] = []
    bytes.push(_u8(value))
    match _string_from_bytes(bytes) {
        Ok { value } => {
            return value
        },
        Err { error } => {
            return ""
        },
    }
}

fun _encode_utf8(cp: int64) -> string! {
    let bytes: uint8[] = []
    if cp < 128 {
        bytes.push(_u8(cp))
    } else if cp < 2048 {
        bytes.push(_u8(192 + cp / 64))
        bytes.push(_u8(128 + cp % 64))
    } else if cp < 65536 {
        bytes.push(_u8(224 + cp / 4096))
        bytes.push(_u8(128 + (cp / 64) % 64))
        bytes.push(_u8(128 + cp % 64))
    } else if cp <= 1114111 {
        bytes.push(_u8(240 + cp / 262144))
        bytes.push(_u8(128 + (cp / 4096) % 64))
        bytes.push(_u8(128 + (cp / 64) % 64))
        bytes.push(_u8(128 + cp % 64))
    } else {
        return error("unicode code point out of range")
    }
    match _string_from_bytes(bytes) {
        Ok { value } => {
            return value
        },
        Err { error } => {
        },
    }
    return error("invalid UTF-8 encoding")
}

fun _join(
    parts: string[],
    opening: string,
    closing: string,
    pretty: bool,
) -> string {
    if len(parts) == 0 {
        return opening + closing
    }
    if pretty {
        return opening +
            "\n    " +
            parts.join(",\n").replace("\n", "\n    ") +
            "\n" +
            closing
    }
    return opening + parts.join(",") + closing
}

/** Render the `pretty` JSON text: four-space indentation, one member or element
 * per line, and inline empty objects/arrays. Number spelling matches `stringify`.
 */
fun JsonValue.debug(self) -> string {
    return _render(self, true)
}
