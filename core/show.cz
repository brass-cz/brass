// Value-to-text protocols: display is human text; debug is structural text.
// Print, interpolation and string.from prefer a nominal display, then effective
// debug. Top-level strings are raw; nullables display null or the inner value.
// Effective debug prefers a nominal debug method, otherwise builtin structure.
// Every nested element, field and payload uses effective debug, including inner
// nullable values. Strings are quoted and escaped in every nested position.
// Builtin structure includes private fields and shows callable fields as opaque.
// Embedded multiline text gains one indent level per record or sum field;
// array and tuple elements add no level, like builtin structural children.

/**
 * Structural text. A nominal type may declare `fun T.debug(self) -> string`;
 * otherwise builtin structure renders its children through effective debug.
 * Strings are quoted and escaped, including array, slice, fixed-array and tuple
 * elements. A top-level value without display also uses its effective debug.
 * An unnarrowed nullable has no `.debug()` method; narrow it before calling.
 * Functions and closures cannot render alone; callable fields show `<opaque>`.
 */
type Debug = {
    debug: (Self) -> string
}

/**
 * The preferred human-readable rendering. Out of the box only the primitives
 * satisfy it (a string displays UNQUOTED); any other type opts in by
 * declaring `fun T.display(self) -> string`, which `"{v}"` interpolation and
 * `print`/`println` then use instead of `debug`.
 */
type Display = {
    display: (Self) -> string
}

// `debug` and `display` agree on every primitive except `string`, whose
// debug form is quoted (`"a".debug() == "\"a\""`, `"a".display() == "a"`).

fun string.debug(self) -> string {
    let out = "\""
    let i: int64 = 0
    while i < len(self) {
        if let c = _string_char_at(self, i) {
            if c == "\"" {
                out += "\\\""
            } else if c == "\\" {
                out += "\\\\"
            } else if _debug_is_byte(c, 8) {
                out += "\\b"
            } else if _debug_is_byte(c, 12) {
                out += "\\f"
            } else if c == "\n" {
                out += "\\n"
            } else if c == "\r" {
                out += "\\r"
            } else if c == "\t" {
                out += "\\t"
            } else if _debug_is_control(c) {
                const b = _string_bytes(c)[0]
                out += "\\u00{_debug_hex(b / 16)}{_debug_hex(b % 16)}"
            } else {
                out += c
            }
            i += len(c)
        } else {
            i += 1
        }
    }
    return out + "\""
}

fun _debug_is_byte(c: string, expected: int64) -> bool {
    const bytes = _string_bytes(c)
    return len(bytes) == 1 && bytes[0] == expected
}

fun _debug_is_control(c: string) -> bool {
    const bytes = _string_bytes(c)
    return len(bytes) == 1 && (bytes[0] < 32 || bytes[0] == 127)
}

fun _debug_hex(value: int64) -> string {
    if value < 10 {
        return string.from(value)
    }
    return ["A", "B", "C", "D", "E", "F"][value - 10]
}

fun string.display(self) -> string {
    return self
}

fun bool.debug(self) -> string {
    return string.from(self)
}

fun bool.display(self) -> string {
    return string.from(self)
}

