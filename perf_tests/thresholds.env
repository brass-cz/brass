# compile into an empty JIT cache; warm cells link objects their warmup stored.
czpm_run_cold_ms="${czpm_run_cold_ms:-1050}"
czpm_run_cold_o2_ms="${czpm_run_cold_o2_ms:-1550}"
czpm_run_warm_ms="${czpm_run_warm_ms:-850}"
